package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// Vehicle Services IDL (VSIDL) schema.
filegroup {
    name: "sdv_vsidl_v1_protos",
    srcs: [
        "sdv/**/*.proto",
    ],
}

// Vehicle Services IDL (VSIDL) schema without stdlib sources.
//
// Will be removed with b/425268763.
filegroup {
    name: "vsidl_v1_proto_rs_sources",
    srcs: [
        "sdv/**/*.proto",
    ],
    exclude_srcs: [
        "sdv/vsidl/v1/annotations.proto",
        "sdv/diagnostics/v1/diagnostics.proto",
    ],
}

// Vehicle Services IDL (VSIDL) standard library.
filegroup {
    name: "sdv_vsidl_v1_stdlib_protos",
    srcs: [
        "sdv/vsidl/v1/annotations.proto",
    ],
}

// Vehicle Services IDL (VSIDL) standard library extension for Diagnostics
filegroup {
    name: "sdv_vsidl_v1_diag_protos",
    srcs: [
        "sdv/diagnostics/v1/diagnostics.proto",
    ],
}
