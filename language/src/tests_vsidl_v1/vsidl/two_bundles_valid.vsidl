# proto-file: //system/software_defined_vehicle/vsidl/language/src/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.test"

service_bundle {
    name: "ServiceBundleOne"

    publisher { message: "Pressure" channel: "ONE" topic: "one" capacity: 8 }
    publisher { message: "Pressure" channel: "TWO" topic: "two" capacity: 8 }

    client { service: "DummyRpc" }

    client { service: "AnotherDummyRpc" }

    diagnostics_declaration {
        data_item {
            id: "data_item_id1"
            message_name: "sdv.test.diagnostics.DataItemOne"
            is_writable: true
        }

        io_control {
            id: "io_control_data1"
            message_name: "sdv.test.diagnostics.IoControllableData"
        }

        event {
            id: "event1"
            extended_data_message_name: "sdv.test.diagnostics.FirstEventExt"
            fault_listener_mask: 0x3
        }

        routine {
            id: "routine1"
            start {
                request: "sdv.test.diagnostics.RoutineRequestParameter"
                response: "sdv.test.diagnostics.RoutineResponseParameter"
            }
            stop {
                response: "Temperature"
            }
        }
    }
}

service_bundle {
    name: "ServiceBundleTwo"

    subscriber { message: "Pressure" channel: "TWO" topic: "two" }

    server { service: "DummyRpc" }

    server { service: "AnotherDummyRpc" service_unit_name: "myrpc" }
}