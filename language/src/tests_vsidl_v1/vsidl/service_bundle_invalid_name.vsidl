# proto-file: system/software_defined_vehicle/core_services/vsidl/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.test"

service_bundle {
  # ERROR: empty name
  name: ""
}

service_bundle {
  # ERROR: Number as first character (forbidden because Rust doesn't allow identifiers starting with a number)
  name: "2A"
}

service_bundle {
  # ERROR: Dot in name
  name: "A.B"
}

service_bundle {
  # ERROR: Rust keyword as name
  name: "impl"
}

service_bundle {
  # ERROR: Java keyword as name
  name: "instanceof"
}

service_bundle {
  # ERROR: C++ keyword as name
  name: "decltype"
}

service_bundle {
  # ERROR: code injection
  name: "A {} fn main() { evil_code(); } impl A"
}
