# proto-file: system/software_defined_vehicle/vsidl/language/src/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.test"

service_bundle {
  name: "PublisherWithInvalidChannel"

  publisher {
    message: "Pressure"
    # Error: Pressure exists as a unit type, but it's does not have a channel 'INVALID_CHANNEL'
    channel: "INVALID_CHANNEL"
  }

  publisher {
    message: "FuelLevel"
    # Error: FuelLevel exists as a unit type, but it's does not have any channels
    channel: "INVALID_CHANNEL2"
  }
}