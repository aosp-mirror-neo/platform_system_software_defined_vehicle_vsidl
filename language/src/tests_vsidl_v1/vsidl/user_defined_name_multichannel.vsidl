# proto-file: system/software_defined_vehicle/vsidl/language/src/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.test"

# Valid example: publisher does not have a user-defined name
service_bundle {
  name: "UserDefinedNameMultipub"

  publisher {
    message: "Pressure"
  }
}

# Valid example: 'Temperature' has multiple channels, publisher specifies which one to use
service_bundle {
  name: "UserDefinedNameMultipleChannels"

  publisher {
    message: "Temperature"
    channel: "ONE"
    service_unit_name: "my-pressure"
  }
}

# Valid example: 'BatteryLevel' has only one channel
service_bundle {
  name: "UserDefinedNameSingleChannel"

  publisher {
    message: "BatteryLevel"
    service_unit_name: "my-battery"
  }
}

# Valid example: 'FuelLevel' has only "UNIQUE" channel
service_bundle {
  name: "UserDefinedNameNoChannels"

  publisher {
    message: "FuelLevel"
    service_unit_name: "my-fuel"
  }
}