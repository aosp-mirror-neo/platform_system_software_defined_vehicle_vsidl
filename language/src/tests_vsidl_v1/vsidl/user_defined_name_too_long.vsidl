package: "sdv.test"

service_bundle {
  name: "UserDefinedNameTooLong"

  publisher {
    message: "Pressure"
    channel: "ONE"
    service_unit_name: "ThisIsAVeryLongPublisherNameThatExceedsOurLimits012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
  }

  publisher {
    message: "Pressure"
    channel: "TWO"
  }

  server {
    service: "sdv.test.DummyRpc"
    service_unit_name: "ThisIsAVeryLongRpcNameThatExceedsOurLimits012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789"
  }
}