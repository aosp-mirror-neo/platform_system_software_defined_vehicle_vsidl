# proto-file: system/software_defined_vehicle/core_services/vsidl/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.test"

service_bundle {
  name: "UserDefinedNameTooLong"

  diagnostics_declaration {
    event {
      id: "event1"

      # Error: User-defined name is not in kebap case
      service_unit_name: "MyPublisher"
    }

    event {
      id: "event2"

      # Error: User-defined name does not start with [a-z]
      service_unit_name: "11-test"
    }

    event {
      id: "event3"

      # Error: User-defined name contains double hyphen
      service_unit_name: "test--test"
    }

    event {
      id: "event4"

      # Error: User-defined name ends with hyphen
      service_unit_name: "test-"
    }

    event {
      id: "event5"

      # Error: User-defined name contains Uppercase letter
      service_unit_name: "Test-test"
    }
  }
}