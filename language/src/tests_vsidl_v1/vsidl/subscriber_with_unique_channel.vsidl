# proto-file: system/software_defined_vehicle/core_services/vsidl/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.test"

# Valid service bundle
service_bundle {
  name: "SubscriberWithUniqueChannel"

  publisher {
    message: "FuelLevel"
  }

  subscriber {
    message: "FuelLevel"
    channel: "UNIQUE"
  }

  unit_type {
    type: "FuelLevel"
  }
}