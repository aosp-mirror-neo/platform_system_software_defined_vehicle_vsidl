service_bundle {
  name: "DuplicatedRpcName1"

  server {
    service: "DummyRpc"
    # Error: This uses the same user-defined name as the server for the same service in DuplicatedRpcName2
    service_unit_name: "my-service"
  }
}

service_bundle {
  name: "DuplicatedRpcName2"

  server {
    service: "sdv.test.DummyRpc"
    # Error: This uses the same user-defined name as the server for the same service in DuplicatedRpcName1
    service_unit_name: "my-service"
  }
}