package: "sdv.test"

service_bundle {
  name: "AllAstNodeTypes"

  publisher {
    message: "Pressure"
    channel: "ONE"
    topic: "one"
    capacity: 8
  }

  publisher {
    message: "Pressure"
    channel: "TWO"
    topic: "two"
    capacity: 8
  }

  subscriber {
    message: "Pressure"
    channel: "TWO"
    topic: "two"
  }

  server {
    service: "DummyRpc"
  }

  client {
    service: "DummyRpc"
  }

  diagnostics_declaration {
    data_item {
      id: "data_item_id1"
      message_name: "sdv.test.diagnostics.DataItemOne"
      is_writable: true
    }
    io_control {
      id: "io_control_data1"
      message_name: "sdv.test.diagnostics.IoControllableData"
    }
    event {
      id: "event1"
      extended_data_message_name: "sdv.test.diagnostics.FirstEventExt"
      fault_listener_mask: 0x3
      topic: "my-topic"
    }
    routine {
      id: "routine1"
      start {
        request: "sdv.test.diagnostics.RoutineRequestParameter"
        response: "sdv.test.diagnostics.RoutineResponseParameter"
      }
      stop {
        response: "Temperature"
      }
      result {
        response: "Temperature"
      }
    }
  }

  build_cfg {
    target_name: "my_custom_target_name"
  }
}

