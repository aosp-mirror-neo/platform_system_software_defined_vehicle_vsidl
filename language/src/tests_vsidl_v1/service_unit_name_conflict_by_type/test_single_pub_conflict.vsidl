# proto-file: //system/software_defined_vehicle/vsidl/language/src/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.test.service.bundle.conflict"

# TestCase: service_unit_names must be unique per type.
# In this set up there are 2 service_bundle ServiceBundleOne and ServiceBundleTwo publish two different channels of the same Type (TirePressure).
# ServiceBundleOne uses auto-generated service_unit_name.
# ServiceBundleTwo uses user-defined service_unit_name.
# This test validates that having the same name for a given type (TirePressure) is not allowed.

service_bundle {
    name: "ServiceBundleOne"

    publisher {
        # This publisher service-unit will have a generated service_unit_name matching the following pattern:
        # <package>-<type>-<channel> all in kebab case
        # resulting in: sdv-test-service-bundle-conflict-tire-pressure-front-left
        message: "TirePressure"
        channel: "FRONT_LEFT"
    }
}

service_bundle {
    name: "ServiceBundleTwo"

    publisher {
        message: "TirePressure"
        channel: "FRONT_RIGHT"
        service_unit_name:"sdv-test-service-bundle-conflict-tire-pressure-front-left"
    }
}