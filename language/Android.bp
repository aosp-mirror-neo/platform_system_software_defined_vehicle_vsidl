rust_test_host {
    name: "sdv_core_vsidl_unit_vsidl_catalog_size_computation_test",
    srcs: [
        "src/message_size.rs",
    ],
    test_suites: [
        "sdv-host-unit-tests",
    ],
    test_options: {
        unit_test: true,
    },
    defaults: [
        "vsidl_v1_test_defaults@rust_defaults",
    ],
}

// Rust protobuf library for VSIDL v1. Used by the VSIDL compiler (vsidlc) for code generation.
// Most targets SHOULD NOT link against this directly.
rust_protobuf {
    name: "libvsidl_v1_proto_rs",
    crate_name: "vsidl_v1",
    protos: [":vsidl_v1_proto_rs_sources"],
    source_stem: "vsidl_v1_proto_source",
    host_supported: true,
    vendor_available: true,
    product_available: true,
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    min_sdk_version: "35",
    header_libs: ["libprotobuf-cpp-lite"],
    exported_include_dirs: ["src/protos"],
    rustlibs: [
        "libvehicle_hal_property_protos",
        "libvsidl_v1_stdlib_proto_rs",
        "libvsidl_v1_stdlib_diag_proto_rs",
    ],
    proto_flags: [
        "-I external/protobuf/src",
    ],
}

// Rust protobuf library for VSIDL v1 standard types.
// Used at runtime and for defining messages with VSIDL annotations.
rust_protobuf {
    name: "libvsidl_v1_stdlib_proto_rs",
    crate_name: "vsidl_v1_stdlib",
    protos: [":sdv_vsidl_v1_stdlib_protos"],
    source_stem: "vsidl_v1_stdlib_proto_source",
    host_supported: true,
    vendor_available: true,
    product_available: true,
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    min_sdk_version: "35",
    header_libs: ["libprotobuf-cpp-lite"],
    exported_include_dirs: ["src/protos"],
    proto_flags: [
        "-I external/protobuf/src",
    ],
}

// Used at runtime by diagnostics mw-extension lib.
rust_protobuf {
    name: "libvsidl_v1_stdlib_diag_proto_rs",
    crate_name: "vsidl_v1_stdlib_diag",
    protos: [":sdv_vsidl_v1_diag_protos"],
    source_stem: "vsidl_v1_diag_proto_source",
    host_supported: true,
    vendor_available: true,
    product_available: true,
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    min_sdk_version: "35",
    header_libs: ["libprotobuf-cpp-lite"],
    exported_include_dirs: ["src/protos"],
    proto_flags: [
        "-I external/protobuf/src",
    ],
}

// Not used by middleware. Allows C++ targets to use the same protobuf files as Rust middleware.
cc_defaults {
    name: "libvsidl_v1_stdlib_proto@cc_defaults",
    srcs: [
        ":sdv_vsidl_v1_stdlib_protos",
    ],
    proto: {
        canonical_path_from_root: false, // Required for including generated .h
        include_dirs: [
            "system/software_defined_vehicle/vsidl/language/src/protos",
        ],
    },
}

// Not used by middleware. Allows Java targets to use the same protobuf files as Rust middleware.
java_defaults {
    name: "libvsidl_v1_stdlib_proto@java_defaults",
    srcs: [
        ":sdv_vsidl_v1_stdlib_protos",
    ],
    proto: {
        include_dirs: [
            "system/software_defined_vehicle/vsidl/language/src/protos",
        ],
    },
}
