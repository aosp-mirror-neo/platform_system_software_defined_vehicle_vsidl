package {
    default_team: "trendy_team_automotive",
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "vsidl_v1_parser_defaults@rust_defaults",
    rustlibs: [
        "libprotobuf",
        "libprotobuf_parse",
        "libanyhow",
        "libwalkdir",
        "libregex",
        "libheck",
        "libanes",
        "libis_terminal",
        "libsdv_vsidl_common",
        "libindexmap",
        "libvsidl_v1_proto_rs",
        "liblazy_static",
        "libmockall",
        "libglob",
        "libtempfile",
        "libunicode_xid",
        "libwalkdir",
        "libsdv_comms_id_validator",
        "libtermcolor",
        "libpest",
    ],
    proc_macros: [
        "libpest_derive",
        "libserde_derive",
    ],
    defaults: [
        "sdv@rust_defaults",
    ],
    compile_multilib: "first",
}

/* --------------------------------- */
// FILEGROUPS
/* --------------------------------- */

filegroup {
    name: "vsidl_v1_test_vsidl_files",
    srcs: ["src/tests_vsidl_v1/**/*.vsidl"],
}

/* --------------------------------- */
// LIBRARIES
/* --------------------------------- */

rust_library_host {
    name: "libvsidl_v1_common",
    crate_name: "vsidl_v1_common",
    srcs: [
        "src/lib.rs",
    ],
    rustlibs: [
        "libvsidl_v1_pest_parser",
    ],
    defaults: [
        "vsidl_v1_parser_defaults@rust_defaults",
    ],
    flags: [
        "-A missing_docs",
    ],
}

rust_library_host {
    name: "libvsidl_v1_pest_parser",
    crate_name: "vsidl_v1_pest_parser",
    srcs: [
        "src/parser/lib.rs",
    ],
    defaults: [
        "vsidl_v1_parser_defaults@rust_defaults",
    ],
    flags: [
        "-A missing_docs",
    ],
}

rust_library_host {
    name: "libvsidl_v1_context_conditions",
    crate_name: "vsidl_v1_context_conditions",
    srcs: [
        "src/context_conditions/lib.rs",
    ],
    rustlibs: [
        "libvsidl_v1_common",
        "libvsidl_v1_symbols",
        "librayon",
        "liblsp_types",
    ],
    defaults: [
        "vsidl_v1_parser_defaults@rust_defaults",
    ],
    flags: [
        "-A missing_docs",
    ],
}

rust_library_host {
    name: "libvsidl_v1_symbols",
    crate_name: "vsidl_v1_symbols",
    srcs: [
        "src/symbols/lib.rs",
    ],
    rustlibs: [
        "libvsidl_v1_common",
        "libvsidl_v1_pest_parser",
    ],
    defaults: [
        "vsidl_v1_parser_defaults@rust_defaults",
    ],
    flags: [
        "-A missing_docs",
    ],
}

rust_library_host {
    name: "libvsidl_v1_parser",
    crate_name: "vsidl_v1_parser",
    srcs: [
        "src/vsidl_v1_parser/lib.rs",
    ],
    rustlibs: [
        "libvsidl_v1_common",
        "libvsidl_v1_symbols",
        "libvsidl_v1_pest_parser",
        "libvsidl_v1_context_conditions",
    ],
    defaults: [
        "vsidl_v1_parser_defaults@rust_defaults",
    ],
    flags: [
        "-A missing_docs",
    ],
}

/* --------------------------------- */
// TESTS
/* --------------------------------- */

rust_defaults {
    name: "vsidl_v1_test_defaults@rust_defaults",
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
    ],
    rustlibs: [
        "libsdv_vsidl_v1_test_protos_rs",
        "libgoogletest_rust",
        "libvsidl_v1_test_data",
    ],
    data: [
        "src/tests_vsidl_v1/**/*",
        ":sdv_vsidl_v1_protos",
    ],
    defaults: [
        "sdv@rust_defaults",
        "vsidl_v1_parser_defaults@rust_defaults",
    ],
}

rust_library_host {
    name: "libvsidl_v1_test_data",
    crate_name: "vsidl_v1_test_data",
    crate_root: "src/test_data.rs",
    srcs: [
        ":vsidl_v1_test_vsidl_files",
    ],
    rustlibs: [
        "libsdv_vsidl_v1_test_protos_rs",
        "libvsidl_v1_common",
        "libvsidl_v1_pest_parser",
    ],
    defaults: [
        "vsidl_v1_parser_defaults@rust_defaults",
    ],
    flags: [
        "-A missing_docs",
    ],
}

