    ],
    data: [
        "src/tests_vsidl_v1/**/*",
        ":sdv_vsidl_v1_protos",
    ],
    defaults: [
        "sdv@rust_defaults",
        "vsidl_v1_parser_defaults@rust_defaults",
    ],
}

