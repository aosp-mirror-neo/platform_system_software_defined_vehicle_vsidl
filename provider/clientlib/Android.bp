package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "vsidl_provider_lib@rust_defaults",
    defaults: [
        "sdv@rust_defaults",
        "sdv_tracing@rust_defaults",
    ],
    rustlibs: [
        "liblog_rust",
        "librustutils",
        "libmockall",
        "libprotobuf",
        "libvsidl_v1_proto_rs",
        "libthiserror",
        "libwalkdir",
        "libdashmap",
        "libsdv_vsidl_common",
        "libsdv_comms_rs",
        "libsdv_status_rs",
        "libsdv_rs",
        "google.sdv.service_bundles_registry-V3-rust",
        "libtokio",
        "libanyhow",
        "libfutures",
        "libfutures_executor",
        "libvsidl_provider_agent_api",
        "libvsidl_provider_agent_protos",
        "libsdv_dump",
        "libstrum",
    ],
    proc_macros: [
        "libasync_trait",
        "libstrum_macros",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
}

rust_library {
    name: "libsdv_config_provider",
    crate_name: "sdv_config_provider",
    defaults: ["vsidl_provider_lib@rust_defaults"],
    srcs: [
        "src/lib.rs",
    ],
    vendor_available: true,
    product_available: true,
    team: "trendy_team_automotive",
}

rust_test {
    name: "sdv_core_vsidl_unit_config_provider_test",
    srcs: ["src/lib.rs"],
    defaults: ["vsidl_provider_lib@rust_defaults"],
    rustlibs: [
        "libtempfile",
        "libprotobuf_parse",
        "libgoogletest_rust",
        "libvsidl_provider_agent_api_test_protos",
    ],
    data: [
        "test_data/v1/invalid/**/*",
        "test_data/v1/with_overwrites/**/*",
        ":generate_vsidl_files_test_v1_catalog_files{someip-config.binpb}",
        ":generate_vsidl_files_test_v1_catalog_files{vsidl-config.binpb}",
    ],
    test_suites: [
        "automotive-sdv-tests",
    ],
    test_options: {
        unit_test: true,
    },
    require_root: true,
    team: "trendy_team_automotive",
}

filegroup {
    name: "test_v1_catalog_files",
    srcs: [
        "test_data/v1/source/**/*",
    ],
}
