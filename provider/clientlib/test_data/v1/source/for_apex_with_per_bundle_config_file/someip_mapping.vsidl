# proto-file: //system/software_defined_vehicle/vsidl/language/src/protos/sdv/someip/v1/someip.proto
# proto-message: SomeIpMapping

package: "com.android.sdv.sample.vsidl_provider.apex_with_per_bundle_config_file"

some_ip_mapping {
  someip_service_mapping {
    someip_service_id: 0x3200
    version_major: 0x1
    version_minor: 0x0
    instance {
        instance_id: 0x1000
        sdv_service_unit_parameterization {key: 0 value: "first_service_unit"}
        sdv_service_unit_parameterization {key: 1 value: "second_service_unit"}
    }
    instance_impl {
        offered_event {
          group_id: 0x9320
          event_id: 0x8320
          simple_event {
            sdv_unit_type {
              package_name: "com.android.sdv.sample.vsidl_provider.apex_with_per_bundle_config_file"
              service_bundle_name: "SomeIpBroker"
              type_name: "SamplePressureUnitType"
            }
            service_unit: 0
            type_definition {
                length_field_size: ZERO
                field {
                  field_name: "pressure"
                  field_type { someip_primitive: UINT32 }
                }
            }
          }
        }
        offered_event {
            group_id: 0x9320
            event_id: 0x8321
            simple_event {
              sdv_unit_type {
                package_name: "com.android.sdv.sample.vsidl_provider.apex_with_per_bundle_config_file"
                service_bundle_name: "SomeIpBroker"
                type_name: "SampleTemperatureUnitType"
              }
              service_unit: 1
              type_definition {
                  length_field_size: ZERO
                  field {
                    field_name: "temperature"
                    field_type { someip_primitive: UINT32 }
                  }
              }
            }
          }
      }
  }
}
