# proto-message: VsidlEntry

package: "com.sdv.google.sample.vsidl_provider.apex_with_per_bundle_config_file"

service_bundle {
    name: "OtherManager"

    publisher {
        message: "com.sdv.google.sample.vsidl_provider.OtherTirePressure"
        channel: "FRONT_LEFT_PER_BUNDLE"
        channel: "FRONT_RIGHT_PER_BUNDLE"
    }
}

service_bundle {
    name: "OtherMonitor"

    subscriber {
        message: "com.sdv.google.sample.vsidl_provider.OtherTirePressure"
        channel: "FRONT_LEFT_PER_BUNDLE"
        channel: "FRONT_RIGHT_PER_BUNDLE"
    }

    publisher {
        message: "com.sdv.google.sample.vsidl_provider.OtherTirePressureRange"
        channel: "PER_BUNDLE"
    }
}
