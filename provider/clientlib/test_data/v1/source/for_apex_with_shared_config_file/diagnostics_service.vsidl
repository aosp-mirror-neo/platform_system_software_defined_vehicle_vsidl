# proto-file: //system/software_defined_vehicle/core_services/vsidl/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "com.sdv.google.sample.vsidl_provider.apex_with_shared_config_file"

service_bundle {
    name: "DiagService"

    # These diagnostics_declarations are used in the following test:
    # tests/sample_tests/vsidl_provider/sdv_sample_vsidl_provider_test.py
    # If they are changed here, the test needs to be updated accordingly
    diagnostics_declaration {
        data_item {
            id: "data_item"
            message_name: "com.sdv.google.sample.vsidl_provider.DataItem"
        }

        routine {
            id: "routine"
            start {
                request: "com.sdv.google.sample.vsidl_provider.DataItem"
                response: "google.protobuf.Timestamp"
            }
            stop {
                response: "com.sdv.google.sample.vsidl_provider.TirePressure"
            }
        }
    }
}