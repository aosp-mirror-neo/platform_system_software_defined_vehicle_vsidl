# proto-file: //system/software_defined_vehicle/core_services/vsidl/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "com.sdv.google.sample.vsidl_provider.apex_with_shared_config_file"

service_bundle {
    name: "Manager"

    publisher {
        message: "com.sdv.google.sample.vsidl_provider.TirePressure"
        channel: "FRONT_LEFT_SHARED"
        channel: "FRONT_RIGHT_SHARED"
    }
}

service_bundle {
    name: "Monitor"

    subscriber {
        message: "com.sdv.google.sample.vsidl_provider.TirePressure"
        channel: "FRONT_LEFT_SHARED"
        channel: "FRONT_RIGHT_SHARED"
    }

    publisher {
        message: "com.sdv.google.sample.vsidl_provider.TirePressureRange"
        channel: "SHARED"
    }
}
