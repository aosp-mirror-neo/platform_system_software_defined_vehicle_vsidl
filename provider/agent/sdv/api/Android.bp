package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_protobuf {
    name: "libvsidl_provider_agent_protos",
    crate_name: "vsidl_provider_agent_protos",
    protos: [
        "protos/*.proto",
    ],
    source_stem: "vsidl_provider_agent_protos",
    proto_flags: [
        "-I external/protobuf/src",
    ],
    rustlibs: [
        "libvsidl_v1_proto_rs",
    ],
    vendor_available: true,
    product_available: true,
}

rust_defaults {
    name: "vsidl_provider_agent_api@rust_defaults",
    defaults: ["sdv@rust_defaults"],
    rustlibs: [
        "liblazy_static",
        "libsdv_comms_rs",
        "libsdv_status_rs",
        "libvsidl_v1_proto_rs",
        "libprotobuf",
        "libvsidl_provider_agent_protos",
        "libsdv_log_rust",
        "liblog_rust",
        "libsdv_vsidl_common",
    ],
    proc_macros: [
        "libasync_trait",
    ],
    ld_flags: ["-Wl,--no-as-needed"],
}

rust_library {
    name: "libvsidl_provider_agent_api",
    crate_name: "vsidl_provider_agent_api",
    defaults: ["vsidl_provider_agent_api@rust_defaults"],
    srcs: [
        "src/lib.rs",
    ],
    vendor_available: true,
    product_available: true,
}

rust_test {
    name: "sdv_core_vsidl_unit_vsidl_provider_agent_api_test",
    crate_name: "vsidl_provider_agent_api",
    defaults: ["vsidl_provider_agent_api@rust_defaults"],
    srcs: [
        "src/lib.rs",
    ],
    rustlibs: [
        "libgoogletest_rust",
        "libvsidl_provider_agent_api_test_protos",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    vendor_available: true,
    product_available: true,
}
