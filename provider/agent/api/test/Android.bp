package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_protobuf {
    name: "libvsidl_provider_agent_api_test_protos",
    crate_name: "vsidl_provider_agent_api_test_protos",
    protos: [
        "*.proto",
    ],
    source_stem: "vsidl_provider_agent_api_test_protos",
    proto_flags: [
        "-I external/protobuf/src",
    ],
    rustlibs: [
        "libvsidl_v1_proto_rs",
    ],
    vendor_available: true,
    product_available: true,
}
