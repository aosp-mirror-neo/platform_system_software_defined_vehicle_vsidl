# Copyright 2024 Google LLC
# proto-file: //system/software_defined_vehicle/core_services/service_authz/proto/sdv/authz/policy/acl_policy.proto
# proto-message: AclPolicy

# ACL policies for Vsidl Provider Agent Unit Types.

acls {
    name: "Internal"
    include: "com.sdv.google.vsidl_provider.Agent"
}

acls {
    name: "VsidlProviderClients"
    include: "com.sdv.someip.SomeIpBroker"
    include: "com.sdv.oem.diagnostics.DiagnosticsAgent"
    include: "com.google.sdv.telemetry.TelemetryService"

    # this is for the tests:
    include: "com.sdv.google.sample.*"
}

unit_types {
    name: "VsidlProviderService"
    acl_names: "Internal"
}

service_units {
    name: "vsidl-provider-server"
    acl_names: "VsidlProviderClients"
}
