package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "vsidl_provider_agent@rust_defaults",
    defaults: [
        "sdv_tracing@rust_defaults",
        "sdv@rust_defaults",
    ],
    srcs: [
        "src/main.rs",
    ],
    rustlibs: [
        "libanyhow",
        "libsdv_log_rust",
        "liblog_rust",
        "libbinder_rs",
        "libsdv_comms_rs",
        "libsdv_comms_ctx_impl",
        "libtokio",
        "libsdv_status_rs",
        "libsdv_config_provider",
        "libprotobuf",
        "libvsidl_provider_agent_api",
        "libvsidl_provider_agent_protos",
        "libsdv_dump",
    ],
    system_ext_specific: true,
}

rust_binary {
    name: "sdv_vsidl_provider_agent",
    defaults: [
        "vsidl_provider_agent@rust_defaults",
    ],
}

rust_test {
    name: "sdv_core_core_services_unit_vsidl_provider_agent_test",
    defaults: ["vsidl_provider_agent@rust_defaults"],
    rustlibs: [
        "libgoogletest_rust",
        "libvsidl_provider_agent_api_test_protos",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "general-tests",
    ],
    test_config_template: ":sdv_authz_enforcement_flag_enabled_config_template",
    team: "trendy_team_automotive",
}
