package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "empty_vsidl_provider_agent_for_ivi@rust_defaults",
    defaults: [
        "sdv_tracing@rust_defaults",
        "sdv@rust_defaults",
    ],
    srcs: [
        "src/main.rs",
    ],
    rustlibs: [
        "libanyhow",
        "libsdv_log_rust",
        "liblog_rust",
        "libbinder_rs",
        "libsdv_comms_rs",
        "libsdv_comms_ctx_impl",
        "libtokio",
        "libsdv_status_rs",
        "libsdv_config_provider",
        "libprotobuf",
        "libvsidl_provider_agent_api",
        "libvsidl_provider_agent_protos",
        "libsdv_dump",
    ],
    system_ext_specific: true,
}

rust_binary {
    name: "sdv_empty_vsidl_provider_agent_for_ivi",
    defaults: [
        "empty_vsidl_provider_agent_for_ivi@rust_defaults",
    ],
}

prebuilt_etc {
    name: "ivi_acl_vsidl_provider_agent_textproto",
    sub_dir: "sdv_authz_acls/com.android.sdv.vsidl_provider",
    src: "ivi_permissions.textproto",
    filename: "Agent.textproto",
    system_ext_specific: true,
}
