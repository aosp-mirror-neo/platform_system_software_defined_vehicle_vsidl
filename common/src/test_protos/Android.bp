rust_protobuf {
    name: "libsdv_vsidl_common_test_protos",
    crate_name: "sdv_vsidl_common_test_protos",
    protos: ["test_messages.proto"],
    source_stem: "sdv_vsidl_common_test_protos",
    proto_flags: [
        "-I external/protobuf/src",
    ],
    rustlibs: [
        "libvsidl_v1_stdlib_proto_rs",
    ],
    host_supported: true,
}
