package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "vsidl_common@rust_defaults",
    defaults: ["sdv@rust_defaults"],
    srcs: ["src/lib.rs"],
    rustlibs: [
        "libprotobuf",
        "liblazy_static",
    ],
}

rust_library {
    name: "libsdv_vsidl_common",
    crate_name: "sdv_vsidl_common",
    defaults: ["vsidl_common@rust_defaults"],
    host_supported: true,
    vendor_available: true,
    product_available: true,
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    min_sdk_version: "35",
}

rust_test {
    name: "sdv_core_vsidl_unit_vsidl_common_test",
    defaults: ["vsidl_common@rust_defaults"],
    rustlibs: ["libsdv_vsidl_common_test_protos"],
    test_suites: [
        "automotive-sdv-tests",
    ],
    test_options: {
        unit_test: true,
    },
}
