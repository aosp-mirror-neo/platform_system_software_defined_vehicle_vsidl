package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "libvsidlc_cli_default",
    srcs: [
        "src/lib.rs",
    ],
    rustlibs: [
        "libvsidl_v1_parser",
        "libanyhow",
        "libtempfile",
    ],
    compile_multilib: "first",
}

rust_library_host {
    name: "libvsidlc_cli",
    crate_name: "vsidlc_cli",
    defaults: [
        "libvsidlc_cli_default",
    ],
}

rust_test_host {
    name: "sdv_core_core_services_unit_vsidlc_cli_test",
    defaults: [
        "libvsidlc_cli_default",
        "sdv@rust_defaults",
    ],
    rustlibs: [
        "libgoogletest_rust",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "sdv-host-unit-tests",
    ],
    data: [
        ":sdv_vsidl_v1_protos",
    ],
}
