{{!-- The template is used in "../diagnostics.tpl" template. --}}
struct RoutineServer {
    {{#each this}}
    {{this.handler_name}}: Arc<dyn RoutineHandler<{{> routine_handler_types_list this}}>>,
    {{/each}}
}

#[async_trait::async_trait]
impl RoutineControlService for RoutineServer {
    async fn StartRoutine(&self,
    _caller_id: sdv::comms::id::ServiceFqin,
    request: &RoutineControlRequest) -> SdvResult<RoutineControlResponse> {
        match request.id.as_str() {
            {{#each this}}
            "{{this.id}}" => {
                Ok(self.{{this.handler_name}}.start_untyped(&request.request).await)
            },
            {{/each}}
            _ => Ok(RoutineControlResponse { response_code: REQUEST_OUT_OF_RANGE.into(), ..Default::default() }),
        }
    }

    async fn StopRoutine(&self,
    _caller_id: sdv::comms::id::ServiceFqin,
    request: &RoutineControlRequest) -> SdvResult<RoutineControlResponse> {
        match request.id.as_str() {
            {{#each this}}
            "{{this.id}}" => {
                Ok(self.{{this.handler_name}}.stop_untyped(&request.request).await)
            },
            {{/each}}
            _ => Ok(RoutineControlResponse { response_code: REQUEST_OUT_OF_RANGE.into(), ..Default::default() }),
        }
    }

    async fn RequestResult(&self,
    _caller_id: sdv::comms::id::ServiceFqin,
    request: &RoutineControlRequest) -> SdvResult<RoutineControlResponse> {
        match request.id.as_str() {
            {{#each this}}
            "{{this.id}}" => {
                Ok(self.{{this.handler_name}}.request_result_untyped(&request.request).await)
            },
            {{/each}}
            _ => Ok(RoutineControlResponse { response_code: REQUEST_OUT_OF_RANGE.into(), ..Default::default() }),
        }
    }
}
