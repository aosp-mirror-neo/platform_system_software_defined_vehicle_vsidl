{{!-- The template is used in "../diagnostics.tpl" template. --}}
struct IoControlServer {
    {{#each this}}
    {{this.handler_name}}: Option<Arc<dyn IoControlHandler<{{this.message}}>>>,
    {{/each}}
}

#[async_trait::async_trait]
impl IoControlService for IoControlServer {
    async fn ReturnControlToEcu(&self,
    _caller_id: sdv::comms::id::ServiceFqin,
    request: &IoControlRequest) -> SdvResult<IoControlResponse> {
        match request.id.as_str() {
            {{#each this}}
            "{{this.id}}" => {
                if let Some(handler) = &self.{{this.handler_name}} {
                    Ok(handler.return_control_to_ecu_untyped(&request.mask).await)
                } else {
                    Ok(IoControlResponse { response_code: REQUEST_OUT_OF_RANGE.into(), ..Default::default() })
                }
            },
            {{/each}}
            _ => Ok(IoControlResponse { response_code: REQUEST_OUT_OF_RANGE.into(), ..Default::default() }),
        }
    }

    async fn ResetToDefault(&self,
    _caller_id: sdv::comms::id::ServiceFqin,
    request: &IoControlRequest) -> SdvResult<IoControlResponse> {
        match request.id.as_str() {
            {{#each this}}
            "{{this.id}}" => {
                if let Some(handler) = &self.{{this.handler_name}} {
                    Ok(handler.reset_to_default_untyped(&request.mask).await)
                } else {
                    Ok(IoControlResponse { response_code: REQUEST_OUT_OF_RANGE.into(), ..Default::default() })
                }
            },
            {{/each}}
            _ => Ok(IoControlResponse { response_code: REQUEST_OUT_OF_RANGE.into(), ..Default::default() }),
        }
    }

    async fn FreezeCurrentState(&self,
    _caller_id: sdv::comms::id::ServiceFqin,
    request: &IoControlRequest) -> SdvResult<IoControlResponse> {
        match request.id.as_str() {
            {{#each this}}
            "{{this.id}}" => {
                if let Some(handler) = &self.{{this.handler_name}} {
                    Ok(handler.freeze_current_state_untyped(&request.mask).await)
                } else {
                    Ok(IoControlResponse { response_code: REQUEST_OUT_OF_RANGE.into(), ..Default::default() })
                }
            },
            {{/each}}
            _ => Ok(IoControlResponse { response_code: REQUEST_OUT_OF_RANGE.into(), ..Default::default() }),
        }
    }

    async fn PerformShortTermAdjustment(&self,
    _caller_id: sdv::comms::id::ServiceFqin,
    request: &PerformShortTermAdjustmentRequest) -> SdvResult<IoControlResponse> {
        match request.id.as_str() {
            {{#each this}}
            "{{this.id}}" => {
                if let Some(handler) = &self.{{this.handler_name}} {
                    Ok(handler.short_term_adjustment_untyped(&request.adjusted_value, &request.mask).await)
                } else {
                    Ok(IoControlResponse { response_code: REQUEST_OUT_OF_RANGE.into(), ..Default::default() })
                }
            },
            {{/each}}
            _ => Ok(IoControlResponse { response_code: REQUEST_OUT_OF_RANGE.into(), ..Default::default() }),
        }
    }
}