{{!-- The template is used in "../diagnostics.tpl" template. --}}
struct FaultListenerServer {
    {{#each this}}
    {{#if this.has_fault_listener}}
    {{this.fault_listener_handler_name}}: Arc<dyn FaultListenerHandler<{{this.full_message_name}}>>,
    {{/if}}
    {{/each}}
}

#[async_trait::async_trait]
impl FaultListenerService for FaultListenerServer {
    async fn OnFaultStatusChange(&self,
    _caller_id: sdv::comms::id::ServiceFqin,
    request: &OnFaultStatusChangeRequest) -> SdvResult<OnFaultStatusChangeResponse> {
        match request.id.as_str() {
            {{#each this}}
            {{#if this.has_fault_listener}}
            "{{this.id}}" => {
                Ok(self.{{this.fault_listener_handler_name}}.on_fault_status_change_untyped(request.status as u8, request.extended_data.as_deref()).await)
            },
            {{/if}}
            {{/each}}
            _ => Ok(OnFaultStatusChangeResponse::default()),
        }
    }
}