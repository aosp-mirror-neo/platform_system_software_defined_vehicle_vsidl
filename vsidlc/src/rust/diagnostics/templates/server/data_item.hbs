{{!-- The template is used in "../diagnostics.tpl" template. --}}
struct DataItemServer {
    {{#each this}}
    {{this.handler_name}}: Arc<dyn {{this.handler_type}}<{{this.message}}>>,
    {{/each}}
}

#[async_trait::async_trait]
impl DataItemService for DataItemServer {
    async fn ReadDataItem(&self,
    _caller_id: sdv::comms::id::ServiceFqin,
    request: &ReadDataItemRequest) -> SdvResult<ReadDataItemResponse> {
        match request.id.as_str() {
            {{#each this}}
            "{{this.id}}" => {
                Ok(self.{{this.handler_name}}.read_untyped().await)
            },
            {{/each}}
            _ => Ok(ReadDataItemResponse { response_code: REQUEST_OUT_OF_RANGE.into(), ..Default::default() }),
        }
    }

    #[allow(clippy::match_single_binding)]
    async fn WriteDataItem(&self,
    _caller_id: sdv::comms::id::ServiceFqin,
    request: &WriteDataItemRequest) -> SdvResult<WriteDataItemResponse> {
        match request.id.as_str() {
            {{#each this}}
            {{#if this.is_writable}}
            "{{this.id}}" => {
                Ok(self.{{this.handler_name}}.write_untyped(&request.value).await)
            },
            {{/if}}
            {{/each}}
            _ => Ok(WriteDataItemResponse { response_code: REQUEST_OUT_OF_RANGE.into(), ..Default::default() })
        }
    }
}