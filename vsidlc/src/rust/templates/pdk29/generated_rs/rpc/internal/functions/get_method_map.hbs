/// Creates a method map for an object which implements the RPC service trait
/// This method map includes only unary RPC methods.
pub fn get_method_map(
    server: std::sync::Arc<dyn super::Interface>,
) -> std::collections::HashMap<String, sdv::comms::rpc::UnaryRpcMethod> {
    sdv::mw::MethodMapBuilder::new()
    {{#each methods}}
    {{#unless this.uses_client_streaming}}
    {{#unless this.uses_server_streaming}}
    .add_method::<{{this.request.crate_name}}::{{this.request.file_name}}::{{this.request.message_name}}, {{this.response.crate_name}}::{{this.response.file_name}}::{{this.response.message_name}}>(
        "{{this.name}}",
        {
            let srv = server.clone();
        std::sync::Arc::new(move |id, req| {
            Box::pin({
                let srv = srv.clone();
                async move { srv.{{this.name}}(id, &req).await }
            })
        })},
    )
    {{/unless}}
    {{/unless}}
    {{/each}}
    .build()
}
