/// Provides access to publications available to the service bundle
pub mod publisher {

/// Alias for backwards compatibility.
pub use Channel as Variant;
/// Lists channels per protobuf message of every publication available to the service bundle
#[derive(Debug)]
pub struct Channel<Proto> {
    _proto: std::marker::PhantomData<Proto>,
    /// Unique id of a channel
    pub id: i32,
    pub(super) service_unit: &'static str,
}

pub(super) trait Metadata {
    const MESSAGE_SIZE: u32;
    const MESSAGE_COUNT: u32;
    const IS_MULTIPUB: bool;
    fn get_message_metadata() -> sdv_proto_reflection_rs::message_metadata::MessageMetadata {
        sdv_proto_reflection_rs::message_metadata::MessageMetadata::default()
    }
}

{{#each publications}}
    {{> service_bundles/publisher/impl_metadata/impl register_reflection_metadata=../register_reflection_metadata}}

    {{> service_bundles/publisher/impl_channel/impl}}

{{/each}}
}
