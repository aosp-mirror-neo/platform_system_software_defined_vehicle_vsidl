/// Creates a new subscriber
pub async fn create_subscriber<
    M: ::protobuf::Message + subscriber::Metadata + UnitType + 'static,
>(
    &mut self,
    channel: &subscriber::Channel<M>,
    options: &sdv::mw::SubscribeOptions,
) -> sdv::status::SdvResult<sdv::mw::Subscriber<M>> {
    let subscribe_handle = match M::IS_MULTIPUB {
        // For single-pub, subscribe to a specific publication.
        false => {
            let publication = self.find_publication(channel, options).await?;
            publication.subscribe(options).await?
        }
        // For multi-pub, subscribe to a message type.
        true => self.comms.subscribe_by_type(&M::to_type_name()?, options).await?,
    };
    Ok(sdv::mw::Subscriber::<M>::new(subscribe_handle))
}

