/// Creates a new instant reader
pub async fn create_instant_reader<
    M: ::protobuf::Message + subscriber::Metadata + UnitType + 'static,
>(
    &mut self,
    channel: &subscriber::Channel<M>,
    options: &sdv::mw::SubscribeOptions,
) -> sdv::status::SdvResult<sdv::mw::InstantReader<M>> {
    if M::IS_MULTIPUB {
        Err(sdv::status::SdvStatus::with_message(
            sdv::status::SdvStatusCode::Unimplemented,
            "Instant Read is not supported for Multipub channels.",
        ))
    } else {
        let publication = self.find_publication(channel, options).await?;
        Ok(sdv::mw::InstantReader::<M>::new(publication.create_instant_read()))
    }
}

