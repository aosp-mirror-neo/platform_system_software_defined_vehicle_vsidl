/// Creates a new event stream
/// If the message channel is MULTIPUB, this stream yields Availability::Available
/// for every publisher publishing this channel.
pub async fn create_registration_event_stream<
    M: ::protobuf::Message + subscriber::Metadata + UnitType + 'static,
>(
    &mut self,
    channel: &subscriber::Channel<M>,
    options: &sdv::mw::SubscribeOptions,
) -> sdv::status::SdvResult<std::pin::Pin<Box<dyn futures::Stream<Item = sdv::mw::Availability> + Send>>> {
    if M::IS_MULTIPUB {
        self.comms
            .create_registration_event_stream(&sdv::mw::UnitQuery::Type(M::to_type_name()?))
            .await
    } else {
        self.comms
            .create_registration_event_stream(&sdv::mw::UnitQuery::Name(
                sdv::mw::UnitName::builder()
                    .vm_name(options.get_vm_name())
                    .package_name(channel.service_bundle_package)
                    .bundle_name(channel.service_bundle_name)
                    .service_unit_name(channel.service_unit)
                    .instance_name(options.get_instance_name())
                    .build()?,
            ))
            .await
    }
}

