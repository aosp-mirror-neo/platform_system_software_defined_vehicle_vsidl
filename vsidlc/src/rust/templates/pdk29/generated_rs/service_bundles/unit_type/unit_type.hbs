{{#if has_unit_types}}

/// UnitType FQN
pub trait UnitType {
    /// Owning package name
    const PACKAGE: &'static str;
    /// Owning service bundle name
    const SERVICE_BUNDLE: &'static str;
    /// Type name
    const TYPENAME: &'static str;

    /// Convert the trait into a TypeName struct
    fn to_type_name() -> sdv::status::SdvResult<sdv::mw::TypeName> {
        sdv::mw::TypeName::builder()
            .package_name(Self::PACKAGE)
            .bundle_name(Self::SERVICE_BUNDLE)
            .type_name(Self::TYPENAME)
            .build()
    }
}

{{#each unit_types}}
impl UnitType for {{#if this.is_rpc_service~}}
    dyn {{this.crate_name}}::Interface
{{~else}}
    {{this.crate_name}}::{{this.proto_filename}}::{{this.proto_type_name}}
{{~/if}} {
    const PACKAGE: &'static str = "{{this.package}}";
    const SERVICE_BUNDLE: &'static str = "{{this.bundle_name}}";
    const TYPENAME: &'static str = "{{this.type_name}}";
}
{{/each}}

{{/if}} {{! has_unit_types}}
