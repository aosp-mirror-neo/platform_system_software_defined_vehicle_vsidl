sdv::lifecycle::register_service_bundle!({{service_bundle_name}}ServiceBundle);

struct {{service_bundle_name}}ServiceBundle {
    cancellation_token: Option<CancellationToken>,
    context: ContextRef,
}

impl ServiceBundle for {{service_bundle_name}}ServiceBundle {
    fn new(context: ContextRef) -> Self {
        if let Err(err) = sdv::tracing::try_init_tracing() {
            warn!("Failed to init service bundles tracing: {err}");
        }
        Self { cancellation_token: None, context }
    }

    fn on_start(&mut self) {
        debug!("on_start called for service bundle...");
        let context = self.context;
        let cancellation_token = CancellationToken::new();
        self.cancellation_token = Some(cancellation_token.clone());
        let Ok(runtime) =
            tokio::runtime::Builder::new_current_thread().enable_time().enable_io().build()
        else {
            panic!("Failed to start the runtime!");
        };
        debug!("spawning thread for service bundle...");
        let _ = std::thread::spawn(move || {
            runtime.block_on(async move {
                debug!("Creating service bundle...");
                let service_bundle =
                    match sdv_mw_rs_{{snake_case @root.package_name}}_{{snake_case service_bundle_name}}::{{service_bundle_name}}::new(
                        Arc::new(SdvComms{context}),
                        {{#if rpc_servers}}
                        (
                            {{#each rpc_servers}}
                            Arc::new({{#if has_user_defined_name}}{{camel_case user_defined_name}}{{else}}{{unit_type.proto_type_name}}{{/if}}RpcImpl::new()),
                            {{/each}}
                        )
                        {{/if}}
                    ).await {
                        Ok(service) => service,
                        Err(e) => {
                            error!("Failed to create service bundle: {e}");
                            return;
                        }
                    };
                debug!("Calling sdv_main...");
                let res = tokio::select! {
                    res = sdv_main(service_bundle) => res,
                    () = cancellation_token.cancelled() => Err(sdv::status::SdvStatus::new(sdv::status::SdvStatusCode::Cancelled)),
                };
                error!("Service bundle loop stopped: {res:?}.");
            });
            drop(runtime);
        });
    }

    fn on_stop(&mut self) {
        self.cancellation_token.as_mut().expect("Must have been created on_start").cancel();
        self.cancellation_token = None;
    }
}

{{#if subscriptions}}
async fn wait_for_available(
    mut event_stream: Pin<Box<dyn futures::Stream<Item = Availability> + Send>>,
) {
    loop {
        debug!("Waiting for publisher loop.");
        match event_stream.next().await {
            Some(Availability::Available) => break, // Subscription topic registered.
            Some(Availability::Unavailable) => {
                debug!("Still waiting for publisher...");
            } // Topic unregistered (ignore for now).
            None => {
                debug!("Stream terminated, publisher not found.");
            } // Stream termination.
        }
    }
    debug!("Publisher found");
}

async fn wait_for_publisher_to_be_available<T>(
    mw_service_bundle: &mut sdv_mw_rs_{{snake_case @root.package_name}}_{{snake_case service_bundle_name}}::{{service_bundle_name}},
    variant: &sdv_mw_rs_{{snake_case @root.package_name}}_{{snake_case service_bundle_name}}::subscriber::Channel<T>,
) -> bool
where
    T: protobuf::Message
        + Debug
        + sdv_mw_rs_{{snake_case @root.package_name}}_{{snake_case service_bundle_name}}::subscriber::Metadata
        + sdv_mw_rs_{{snake_case @root.package_name}}_{{snake_case service_bundle_name}}::UnitType,
{
    debug!("Waiting for publisher {variant:#?}");
    if let Ok(event_stream) = mw_service_bundle
        .create_registration_event_stream(variant, &SubscribeOptions::default())
        .await
    {
        wait_for_available(event_stream).await;
        true
    } else {
        error!("unable to generate a registration event for {variant:#?}");
        false
    }
}
{{/if}}

async fn sdv_main(mut service_bundle: sdv_mw_rs_{{snake_case @root.package_name}}_{{snake_case service_bundle_name}}::{{service_bundle_name}}) -> sdv::status::SdvResult<()> {
    info!("Starting service bundle '{{service_bundle_name}}'");

    let mut futures_join_set = tokio::task::JoinSet::new();

    {{#each publications}}
    {{#each this.1}}
    if let Some(publisher) = service_bundle.take_publisher(sdv_mw_rs_{{snake_case @root.package_name}}_{{snake_case ../../service_bundle_name}}::publisher::Channel::<{{../this.0.unit_type.proto_type_name}}>::{{this.channel_name}}) {
        futures_join_set.spawn(handle_{{snake_case ../this.0.unit_type.proto_type_name}}_{{snake_case this.channel_name}}_publisher(publisher));
    } else {
        error!("Failed to take publisher {{../this.0.unit_type.proto_type_name}}#{{this.channel_name}}");
    }
    {{/each}}
    {{/each}}

    {{#each subscriptions}}
    {{#each this.1}}
    let variant = sdv_mw_rs_{{snake_case @root.package_name}}_{{snake_case ../../service_bundle_name}}::subscriber::Channel::<{{../this.0.unit_type.proto_type_name}}>::{{this.channel_name}};
    if wait_for_publisher_to_be_available(&mut service_bundle, variant).await {
        if let Ok(observer) = service_bundle.create_observer(variant, &sdv::mw::SubscribeOptions::default()).await {
            futures_join_set.spawn(handle_{{snake_case ../this.0.unit_type.proto_type_name}}_{{snake_case this.channel_name}}_observer(observer));
        } else {
            error!("Failed to create observer {{../this.0.unit_type.proto_type_name}}#{{this.channel_name}}");
        }
    }
    {{/each}}
    {{/each}}

    {{#each rpc_clients}}
    if let Some(client) = create_{{#if has_user_defined_name}}{{snake_case user_defined_name}}{{else}}{{snake_case unit_type.proto_type_name}}{{/if}}_rpc_client_with_retry(&mut service_bundle).await {
        futures_join_set.spawn(handle_{{#if has_user_defined_name}}{{snake_case user_defined_name}}{{else}}{{snake_case unit_type.proto_type_name}}{{/if}}_client(client));
    }
    {{/each}}

    while let Some(e) = futures_join_set.join_next().await {
        error!("Future joined with result: {e:?}");
    }

    Ok(())
}

