async fn create_{{#if has_user_defined_name}}{{snake_case user_defined_name}}{{else}}{{snake_case unit_type.proto_type_name}}{{/if}}_rpc_client_with_retry(service_bundle: &mut sdv_mw_rs_{{snake_case @root.package_name}}_{{snake_case ../service_bundle_name}}::{{../service_bundle_name}}) -> Option<{{this.unit_type.crate_name}}::Client> {
    let sleep_duration = Duration::from_secs(1);
    let mut retries = 30;
    loop {
        let client = service_bundle.create_rpc_client::<{{this.unit_type.crate_name}}::Client>(
            sdv::mw::UnitName::builder()
                {{#if this.has_alternative_servers}}
                // There are multiple possible servers (bundle_name):
                {{#each this.servers}}
                // (package_name: '{{this.0}}', bundle_name: '{{this.1}}'){{#unless @last}},{{/unless}}
                {{/each}}
                // TODO: Choose the server that best fits your need
                {{/if}}
                .package_name("{{this.servers.0.0}}")
                .bundle_name("{{this.servers.0.1}}")
                .service_unit_name({{this.unit_type.crate_name}}::Client::DEFAULT_UNIT_NAME)
                .instance_name("instance")
                .build()
                .unwrap(),
            sdv::mw::ClientOptions::default(),
        ).await;
        if let Ok(client) = client {
            return Some(client);
        }
        retries -= 1;
        if retries < 0 {
            error!("Failed to create client");
            return None;
        }
        sleep(sleep_duration).await;
    }
}

