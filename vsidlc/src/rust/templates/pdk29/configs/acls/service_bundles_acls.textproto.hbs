# ---------------------- Publications ----------------------
{{#each acls.message_unit_types}}
# ACL for all publishers of the {{this.name}} topic.
acls {
    name: "{{this.acl_name}}"
    {{#each this.members}}
    include: "{{this}}"
    {{/each}}
}

# {{this.name}} Pub/Sub unit type (i.e. topic).
unit_types {
    name: "{{this.name}}"
    acl_names: "{{this.acl_name}}"
}
{{/each}}

{{#each acls.message_service_units}}
# ACL for subscribers of the {{this.name}} service unit.
acls {
    name: "{{this.acl_name}}"
    {{#each this.members}}
    include: "{{this}}"
    {{/each}}
}

# {{this.name}} Pub/Sub service unit (i.e. publisher).
service_units {
    name: "{{this.name}}"
    acl_names: "{{this.acl_name}}"
}
{{/each}}

# ---------------------- RPC Services ----------------------
{{#each acls.rpc_unit_types}}
# ACL for all servers of the {{this.name}} service.
acls {
    name: "{{this.acl_name}}"
    {{#each this.members}}
    include: "{{this}}"
    {{/each}}
}

# {{this.name}} RPC unit type (i.e. service).
unit_types {
    name: "{{this.name}}"
    acl_names: "{{this.acl_name}}"
}
{{/each}}

{{#each acls.rpc_service_units}}
# ACL for clients of the {{this.name}} service unit.
acls {
    name: "{{this.acl_name}}"
    {{#each this.members}}
    include: "{{this}}"
    {{/each}}
}

# {{this.name}} RPC service unit (i.e. server).
service_units {
    name: "{{this.name}}"
    acl_names: "{{this.acl_name}}"
}
{{/each}}
