# proto-file: //system/software_defined_vehicle/service_bundles_registry/proto/sdv_service_bundles_manifest.proto
# proto-message: SdvServiceBundleManifestEntry

{{#each service_bundles}}
sdv_service_bundle_metadata {
  name: "{{this.name}}"
  version_number: 0
  version_name: "0.1 Alpha"
  authorization_policy_path: "etc/permissions/{{this.full_name}}.permissions"
  orchestration_config_path: "etc/orch/{{this.short_name}}.config"
  native_library_path: "lib64/libsdv_lm_{{this.snake_case_name}}.so"
}
{{/each}}