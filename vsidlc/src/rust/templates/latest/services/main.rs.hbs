async fn create_{{#if has_user_defined_name}}{{snake_case user_defined_name}}{{else}}{{snake_case unit_type.proto_type_name}}{{/if}}_rpc_client_with_retry(comms: &dyn sdv::mw::Communicate) -> Option<{{this.unit_type.crate_name}}::Client> {
    use sdv_mw_rs_{{snake_case @root.package_name}}_{{snake_case ../service_bundle_name}}::client;

    info!("Waiting for {{this.unit_type.proto_type_name}} to be available...");
    let Ok(mut event_stream) = clientlib::create_server_registration_event_stream(
        comms,
        client::Descriptor::<{{this.unit_type.crate_name}}::Client>::{{upper_snake_case this.unit_type.proto_type_name}},
    )
    .await
    else {
        error!("Failed to create registration event stream for {{this.unit_type.proto_type_name}}");
        return None;
    };

    while let Some(event) = event_stream.next().await {
        if event == Availability::Available {
            info!("{{this.unit_type.proto_type_name}} is available.");
            break;
        }
    }

    info!("Creating client for {{this.unit_type.proto_type_name}}");
    match clientlib::create_rpc_client(
        comms,
        client::Descriptor::<{{this.unit_type.crate_name}}::Client>::{{upper_snake_case this.unit_type.proto_type_name}},
        sdv::mw::ClientOptions::default(),
    )
    .await {
        Ok(client) => Some(client),
        Err(e) => {
            error!("Failed to create client for {{this.unit_type.proto_type_name}}: {e:?}");
            None
        }
    }
}

