async fn sdv_main(
    comms: Arc<dyn Communicate>,
) -> sdv::status::SdvResult<()> {
    info!("Starting service bundle '{{service_bundle_name}}'");

    debug!("Creating service bundle...");
    let {{#if is_publisher}}mut{{/if}} _service_bundle =
        match sdv_mw_rs_{{snake_case @root.package_name}}_{{snake_case service_bundle_name}}::{{service_bundle_name}}::builder()
            .set_comms(comms.clone())
            {{#each rpc_servers}}
            .set_server_{{snake_case user_defined_name}}(Arc::new({{#if has_user_defined_name}}{{camel_case user_defined_name}}{{else}}{{unit_type.proto_type_name}}{{/if}}RpcImpl::new()))
            {{/each}}
            .build()
            .await {
            Ok(service) => service,
            Err(e) => {
                error!("Failed to build service bundle: {e}");
                return Err(sdv::status::SdvStatus::with_message(sdv::status::SdvStatusCode::Internal, e.to_string()));
            }
        };

    {{#unless is_empty}}
    let mut futures_join_set = tokio::task::JoinSet::new();
    {{/unless}}

    {{#each publications}}
    {{#each this.1}}
    if let Ok(publisher) = clientlib::create_publisher(comms.as_ref(), sdv_mw_rs_{{snake_case @root.package_name}}_{{snake_case ../../service_bundle_name}}::publisher::Channel::<{{../this.0.unit_type.proto_type_name}}>::{{upper_snake_case this.channel_name}}).await {
        futures_join_set.spawn(handle_{{snake_case ../this.0.unit_type.proto_type_name}}_{{snake_case this.channel_name}}_publisher(publisher));
    } else {
        error!("Failed to create publisher {{../this.0.unit_type.proto_type_name}}#{{this.channel_name}}");
    }
    {{/each}}
    {{/each}}

    {{#each subscriptions}}
    {{#each this.1}}
    let variant = sdv_mw_rs_{{snake_case @root.package_name}}_{{snake_case ../../service_bundle_name}}::subscriber::Channel::<{{../this.0.unit_type.proto_type_name}}>::{{upper_snake_case this.channel_name}};
    if wait_for_publisher_to_be_available(comms.as_ref(), variant).await.is_ok() {
        if let Ok(observer) = clientlib::create_observer(comms.as_ref(), variant, &sdv::mw::SubscribeOptions::default()).await {
            futures_join_set.spawn(handle_{{snake_case ../this.0.unit_type.proto_type_name}}_{{snake_case this.channel_name}}_observer(observer));
        } else {
            error!("Failed to create observer {{../this.0.unit_type.proto_type_name}}#{{upper_snake_case this.channel_name}}");
        }
    }
    {{/each}}
    {{/each}}

    {{#each rpc_clients}}
    if let Some(client) = create_{{#if has_user_defined_name}}{{snake_case user_defined_name}}{{else}}{{snake_case unit_type.proto_type_name}}{{/if}}_rpc_client_with_retry(comms.as_ref()).await {
        futures_join_set.spawn(handle_{{#if has_user_defined_name}}{{snake_case user_defined_name}}{{else}}{{snake_case unit_type.proto_type_name}}{{/if}}_client(client));
    }
    {{/each}}

    {{#if has_clients_or_subscriptions}}
    while let Some(e) = futures_join_set.join_next().await {
        error!("Future joined with result: {e:?}");
    }
    {{else}}
    {{#unless is_empty}}
    std::future::pending::<()>().await;
    {{/unless}}
    {{/if}}

    Ok(())
}

