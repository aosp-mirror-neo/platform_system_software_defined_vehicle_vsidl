/// Waits until a publisher for the given `channel` becomes available.
///
/// This function creates a registration event stream and waits for the first
/// `Availability::Available` event, indicating that a publisher is ready.
/// It can be used to synchronize a subscriber with a publisher, ensuring
/// the publisher is active before attempting to subscribe.
///
/// # Arguments
/// * `comms` - A reference to the `Communicate` trait object for middleware communication.
/// * `channel` - The subscription channel to wait for.
pub async fn wait_for_publisher_to_be_available<C: clientlib::subscriber::Channel>(
    comms: &dyn Communicate,
    channel: &C,
) -> SdvResult<()> {
    debug!("Waiting for publisher {channel:#?}");
    let mut event_stream = clientlib::create_registration_event_stream(comms, channel)
        .await
        .map_err(|e| {
            error!("unable to generate a registration event: {e:?}");
            e
        })?;

    loop {
        debug!("Waiting for publisher loop.");
        match event_stream.next().await {
            Some(Availability::Available) => break, // Subscription topic registered.
            Some(Availability::Unavailable) => {
                debug!("Still waiting for publisher...");
            } // Topic unregistered (ignore for now).
            None => {
                debug!("Stream terminated.");
                break;
            } // Stream termination.
        }
    }
    debug!("Publisher found");
    Ok(())
}
