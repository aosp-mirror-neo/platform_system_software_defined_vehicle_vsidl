package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// ACLs policy for {{package_name}} sample.
prebuilt_etc {
    name: "{{package_name}}.acls.config",
    sub_dir: "acls",
    src: "{{package_name}}_acls.textproto",
    // Filename is used in sdv service bundle metadata manifest.
    filename: "{{package_name}}.acl",
    // Disable direct installation of the manifest to one of the partitions.
    // The manifest will be used only inside of service bundles registry apexes.
    installable: false,
}