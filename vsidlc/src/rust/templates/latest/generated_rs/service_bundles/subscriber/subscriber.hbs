/// Provides access to subscriptions available to the service bundle
pub mod subscriber {

/// Lists channels per protobuf message of every subscription available to the service bundle
///
/// This struct acts as an opaque handle to a specific subscription channel.
/// It should be passed to middleware functions (e.g., `create_subscriber`)
/// but its internal details are not part of the public API for service bundle authors.
#[derive(Debug)]
pub struct Channel<Proto: ::protobuf::Message> {
    _proto: std::marker::PhantomData<Proto>,
    /// Unique name of a channel
    pub name: &'static str,
    service_bundle_package: &'static str,
    service_bundle_name: &'static str,
    service_unit: &'static str,
}

