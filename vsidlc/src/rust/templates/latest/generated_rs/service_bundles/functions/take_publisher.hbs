/// Take the ownership of the publisher object
/// Will return None if called more than once per publisher channel
pub fn take_publisher<M: protobuf::Message + 'static>(
    &mut self,
    channel: &publisher::Channel<M>,
) -> Option<sdv::mw::Publisher<M>> {
    let guarded_publisher = *self
            .publishers
            .remove(&(std::any::TypeId::of::<M>(), channel.name.to_string()))?
            .downcast::<std::sync::Mutex<sdv::mw::Publisher<M>>>()
            .unwrap();
    Some(guarded_publisher.into_inner().unwrap())
}

