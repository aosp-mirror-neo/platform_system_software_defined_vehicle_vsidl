async fn fill_publication_channels<M: UnitType + publisher::Metadata + ::protobuf::Message + 'static>(
    &mut self,
    channels: &[&publisher::Channel<M>]) -> sdv::status::SdvResult<()>
{
    for channel in channels {
        let publish_handle = self.comms
        .create_publish(
            &sdv::mw::PublisherAttributes::builder()
                .publication_name(channel.service_unit)
                .type_name(
                    sdv::mw::TypeName::builder()
                        .package_name(M::PACKAGE)
                        .bundle_name(M::SERVICE_BUNDLE)
                        .type_name(M::TYPENAME)
                        .build()?,
                )
                .metadata(
                    sdv::mw::PublisherMetadata::builder()
                        .message_size(M::MESSAGE_SIZE)
                        .message_count(channel.capacity)
                        .is_multipub(M::IS_MULTIPUB)
                        .message_metadata(M::get_message_metadata())
                        .message_metadata_required({{register_reflection_metadata}})
                        .build()?,
                )
                .build()?,
        )
        .await?;
        self.publishers.insert(
            (std::any::TypeId::of::<M>(), channel.name.to_string()),
            Box::new(std::sync::Mutex::new(sdv::mw::Publisher::<M>::new(publish_handle))),
        );
    }
    Ok(())
}

