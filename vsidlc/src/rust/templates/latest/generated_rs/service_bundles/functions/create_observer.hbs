/// Creates a new observer
pub async fn create_observer<
    M: ::protobuf::Message + subscriber::Metadata + UnitType + 'static,
>(
    &mut self,
    channel: &subscriber::Channel<M>,
    options: &sdv::mw::SubscribeOptions,
) -> sdv::status::SdvResult<
    std::pin::Pin<
        Box<dyn futures::stream::Stream<Item = sdv::status::SdvResult<Vec<M>>> + Send>,
    >,
> {
    let byte_buffer_stream = match M::IS_MULTIPUB {
        // For single-pub, observe a specific publication.
        false => {
            let publication = self.find_publication(channel, options).await?;
            publication.observe(options).await?
        }
        // For multi-pub, observe a message type.
        true => self.comms.observe_by_type(&M::to_type_name()?, options).await?,
    };
    Ok(sdv::mw::observe::<M>(byte_buffer_stream))
}

