/// Creates a new instance of the service bundle
#[deprecated(since = "2.0.0", note = "please use `builder` instead")]
pub async fn new(comms: std::sync::Arc<dyn sdv::mw::Communicate>,
    {{#if is_server}}
    servers: (
        {{#each rpc_servers}}
        std::sync::Arc<dyn {{this.unit_type.crate_name}}::Interface>,
        {{/each}}
    ),
    {{/if}}
    ) -> sdv::status::SdvResult<Self> {
    let {{#if mutable_service}}mut{{/if}} service = Self {
        {{#unless used_comms}}_{{/unless}}comms: comms.clone(),

        {{#if is_server}}
        servers: std::vec::Vec::new(),
        {{/if}}
        {{#if has_diagnostics}}
        diagnostics: Diagnostics::new(comms).await?,
        {{/if}}
    };
    {{#each rpc_servers}}
    service.servers.push(
        sdv::mw::clientlib::create_server::<dyn {{this.unit_type.crate_name}}::Interface>(
            comms.as_ref(),
            {{#if this.has_user_defined_name}}
            "{{this.user_defined_name}}".to_string(),
            {{else}}
            {{this.unit_type.crate_name}}::internal::DEFAULT_UNIT_NAME.to_string(),
            {{/if}}
            {{this.unit_type.crate_name}}::internal::get_rpc_method_map(servers.{{@index}}.clone()),
            servers.{{@index}}.init_server_options(),
        )
        .await?,
    );
    {{/each}}
    Ok(service)
}
