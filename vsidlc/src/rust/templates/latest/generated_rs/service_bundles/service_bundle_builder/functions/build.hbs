/// Creates an instance of `{{../service_bundle_name}}`.
///
/// # Errors
/// Returns an `SdvStatus` with `SdvStatusCode::InvalidArgument` if `comms` has not been set.
pub async fn build(self) -> sdv::status::SdvResult<{{../service_bundle_name}}> {
    let comms = self.comms.ok_or_else(|| {
        sdv::status::SdvStatus::with_message(
            sdv::status::SdvStatusCode::InvalidArgument,
            "No comms is found in {{../service_bundle_name}}Builder",
        )
    })?;

    let {{#if mutable_service}}mut{{/if}} service = {{../service_bundle_name}} {
        {{#unless used_comms}}_{{/unless}}comms: comms.clone(),
        {{#if is_server}}
        servers: std::vec::Vec::new(),
        {{/if}}
        {{#if has_diagnostics}}
        diagnostics: Diagnostics::new(comms).await?,
        {{/if}}
    };

    {{#each rpc_servers}}
    {{#if this.channel}}
    if let Some(server) = self.server_{{snake_case this.channel}} {
        service.servers.push(
            sdv::mw::clientlib::create_server::<dyn {{this.unit_type.crate_name}}::Interface>(
                comms.as_ref(),
                "{{this.channel}}".to_string(),
                {{this.unit_type.crate_name}}::internal::get_rpc_method_map(server.clone()),
                server.init_server_options(),
            )
            .await?
        );
    }
    {{else}}
    if let Some(server) = self.server_{{snake_case this.user_defined_name}} {
        service.servers.push(
            sdv::mw::clientlib::create_server::<dyn {{this.unit_type.crate_name}}::Interface>(
                comms.as_ref(),
                "{{this.user_defined_name}}".to_string(),
                {{this.unit_type.crate_name}}::internal::get_rpc_method_map(server.clone()),
                server.init_server_options(),
            )
            .await?
        );
    }
    {{/if}}
    {{/each}}

    Ok(service)
}