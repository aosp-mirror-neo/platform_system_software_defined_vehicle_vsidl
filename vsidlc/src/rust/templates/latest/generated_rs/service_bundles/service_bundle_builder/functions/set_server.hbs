{{#each rpc_servers}}
{{#if this.channel}}
/// Sets the server implementation for the `{{snake_case this.channel}}` service.
///
/// # Arguments
/// * `server` - An `Arc` containing the implementation of the `Interface` trait.
pub fn set_server_{{snake_case this.channel}}(mut self, server: std::sync::Arc<dyn {{this.unit_type.crate_name}}::Interface>) -> Self {
    self.server_{{snake_case this.channel}} = Some(server);
    self
}
{{else}}
/// Sets the server implementation for the `{{snake_case this.user_defined_name}}` service.
///
/// # Arguments
/// * `server` - An `Arc` containing the implementation of the `Interface` trait.
pub fn set_server_{{snake_case this.user_defined_name}}(mut self, server: std::sync::Arc<dyn {{this.unit_type.crate_name}}::Interface>) -> Self {
    self.server_{{snake_case this.user_defined_name}} = Some(server);
    self
}
{{/if}}
{{/each}} {{! rpc_servers}}