/// Provides access to publications available to the service bundle
pub mod publisher {

/// Lists channels per protobuf message of every publication available to the service bundle
///
/// This struct acts as an opaque handle to a specific publication channel.
/// Its internal details are not part of the public API for service bundle authors.
#[derive(Debug)]
pub struct Channel<Proto: ::protobuf::Message> {
    _proto: std::marker::PhantomData<Proto>,
    /// Unique id of a channel
    pub id: i32,
    service_unit: &'static str,
}

