/// Provides access to RPC clients available to the service bundle
pub mod client {

    /// A strongly-typed handle identifying a specific RPC client channel.
    ///
    /// This struct carries the channel information required to connect to the service
    /// and enforces type safety by associating the channel with its specific `ClientType`.
    /// It is intended for use with middleware functions like `create_rpc_client`.
    #[derive(Debug)]
    pub struct Descriptor<T> {
      channel: &'static str,
      _phantom: std::marker::PhantomData<T>,
    }

