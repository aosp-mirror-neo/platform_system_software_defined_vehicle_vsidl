                if let Some(handler) = &self.io_control_handler {
                    Ok(
                        handler
                            .short_term_adjustment_untyped(
                                &request.adjusted_value,
                                &request.mask,
                            )
                            .await,
                    )
                } else {
                    Ok(IoControlResponse {
                        response_code: REQUEST_OUT_OF_RANGE.into(),
                        ..Default::default()
                    })
                }
            }
            "io_control.with.dot" => {
                if let Some(handler) = &self.io_control_with_dot_handler {
                    Ok(
                        handler
                            .short_term_adjustment_untyped(
                                &request.adjusted_value,
                                &request.mask,
                            )
                            .await,
                    )
                } else {
                    Ok(IoControlResponse {
                        response_code: REQUEST_OUT_OF_RANGE.into(),
                        ..Default::default()
                    })
                }
            }
            _ => {
                Ok(IoControlResponse {
                    response_code: REQUEST_OUT_OF_RANGE.into(),
                    ..Default::default()
                })
            }
        }
    }
}
struct FaultListenerServer {
    event_with_dot_handler: Arc<
        dyn FaultListenerHandler<sdv_vsidlc_goldens_catalog::tire::TIREPressure>,
    >,
    event_with_uppercase_handler: Arc<
        dyn FaultListenerHandler<sdv_vsidlc_goldens_catalog::tire::TIREPressure>,
    >,
}
impl From<FaultListenerServerBuilder> for FaultListenerServer {
    fn from(builder: FaultListenerServerBuilder) -> Self {
        Self {
            event_with_dot_handler: builder.event_with_dot_handler.unwrap(),
            event_with_uppercase_handler: builder.event_with_uppercase_handler.unwrap(),
        }
    }
}
#[async_trait::async_trait]
impl FaultListenerService for FaultListenerServer {
    async fn OnFaultStatusChange(
        &self,
        _caller_id: sdv::comms::id::ServiceFqin,
        request: &OnFaultStatusChangeRequest,
    ) -> SdvResult<OnFaultStatusChangeResponse> {
        match request.id.as_str() {
            "event.with.dot" => {
                Ok(
                    self
                        .event_with_dot_handler
                        .on_fault_status_change_untyped(
                            request.status as u8,
                            request.extended_data.as_deref(),
                        )
                        .await,
                )
            }
            "EVENT.WITH.UPPERCASE" => {
                Ok(
                    self
                        .event_with_uppercase_handler
                        .on_fault_status_change_untyped(
                            request.status as u8,
                            request.extended_data.as_deref(),
                        )
                        .await,
                )
            }
            _ => Ok(OnFaultStatusChangeResponse::default()),
        }
    }
}
