# proto-file: //system/software_defined_vehicle/vsidl/language/src/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.golden"

service_bundle {
    name: "GoldenTireMonitor"
    subscriber {
        message: ".sdv.golden.TIREPressure"
        topic: "tire-pressure-front-left"
        topic: "tire-pressure-front-right"
        topic: "tire-pressure-rear-left"
        topic: "tire-pressure-rear-right"
    }

    subscriber {
        message: "TirePressureExplicitInstances"
        topic: "tire-pressure-explicit-front-left"
        topic: "tire-pressure-explicit-front-right"
        topic: "tire-pressure-explicit-rear-left"
        topic: "tire-pressure-explicit-rear-right"
    }
}
