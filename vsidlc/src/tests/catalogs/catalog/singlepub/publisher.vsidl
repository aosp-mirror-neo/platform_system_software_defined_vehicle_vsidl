# proto-file: //system/software_defined_vehicle/core_services/vsidl/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.golden"

service_bundle {
    name: "GoldenTireSensorsReader"

    # publisher of owned type TirePressure
    # TirePressure has multiple channels and by default all of them
    # will be published by this ServiceBundle.
    publisher {
        message: ".sdv.golden.TIREPressure"
    }

    # publisher of owned type TirePressureExplicitInstances
    # TirePressure has multiple channels and by default all of them
    # will be published by this ServiceBundle.
    publisher {
        message: "TirePressureExplicitInstances"
        channel: "FRONT_LEFT"
        channel: "FRONT_RIGHT"
        channel: "REAR_LEFT"
        channel: "REAR_RIGHT"
    }

    # publisher of not-owned type TireTemperature
    # TireTemperature has multiple channels, but
    # only one is published by this ServiceBundle
    publisher {
        message: "TireTemperature"
        channel: "FRONT_RIGHT"
    }

    # publisher of owner type VehicleSpeed
    # VehicleSpeed has a unique topic
    publisher {
        message: "VehicleSpeed"
    }
}

service_bundle {
    name: "GoldenSizeLimitPublisher"
    publisher {
        message: "sdv.golden.size_limit.MessageWithSizeLimit"
    }
}
