# proto-file: //system/software_defined_vehicle/vsidl/language/src/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.golden"

service_bundle {
    name: "GoldenClientOrSubscriberOnly"

    client {
        service: "sdv.golden.rpc.TireStatus"
        channel: "sdv-golden-rpc-tire-status"
    }

    subscriber {
        message: "VehicleSpeed"
        topic: "vehicle-speed"
    }
}

service_bundle {
    name: "GoldenTireAlert"
    subscriber {
        message: "TIREPressure"
        topic: "tire-pressure-front-left"
        topic: "tire-pressure-front-right"
        topic: "tire-pressure-rear-left"
        topic: "tire-pressure-rear-right"
    }
    subscriber {
        message: "VehicleSpeed"
        topic: "vehicle-speed"
    }
    client {
        service: "sdv.golden.rpc.TireStatus"
        channel: "sdv-golden-rpc-tire-status"
    }

    #Validate generation with empty diagnostics declaration
    diagnostics_declaration {
    }
}

service_bundle {
    name: "GoldenDiagnostics"
    diagnostics_declaration {
        data_item {
            id: "data_item"
            message_name: "VehicleSpeed"
        }

        data_item {
            id: "data_item.with.dot"
            message_name: "VehicleSpeed"
        }

        event {
            id: "event"
            extended_data_message_name: "sdv.golden.TIREPressure"
        }

        event {
            id: "event2"
            extended_data_message_name: "sdv.golden.TIREPressure"
            service_unit_name: "second-event"
        }

        event {
            id: "event.with.dot"
            extended_data_message_name: "sdv.golden.TIREPressure"
            fault_listener_mask: 0x3
        }

        event {
            id: "EVENT.WITH.UPPERCASE"
            extended_data_message_name: "sdv.golden.TIREPressure"
            fault_listener_mask: 0x3
        }

        routine {
            id: "routine"
            start {
                request: "google.protobuf.Timestamp"
            }
        }

        routine {
            id: "routine.with.dot"
            start {
                request: "google.protobuf.Timestamp"
            }
        }

        io_control {
            id: "io_control"
            message_name: "VehicleSpeed"
        }

        io_control {
            id: "io_control.with.dot"
            message_name: "VehicleSpeed"
        }
    }
}
