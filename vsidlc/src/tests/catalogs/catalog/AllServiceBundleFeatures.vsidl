# proto-file: //system/software_defined_vehicle/vsidl/language/src/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.golden"

service_bundle {
    name: "AllServiceBundleFeatures"

    publisher { message: "Pressure" channel: "PRESSURE_ONE" topic: "pressure-one" capacity: 8 }
    publisher { message: "Pressure" channel: "PRESSURE_TWO" topic: "pressure-two" capacity: 8 }
    subscriber { message: "Pressure" channel: "PRESSURE_TWO" topic: "pressure-two" }

    server { service: "DummyRpc" channel: "dummy-rpc" }
    client { service: "DummyRpc" channel: "dummy-rpc" }

    diagnostics_declaration {
        data_item {
            id: "data_item_id1"
            message_name: "sdv.test.diagnostics.DataItemOne"
            is_writable: true
        }

        io_control {
            id: "io_control_data1"
            message_name: "sdv.test.diagnostics.IoControllableData"
        }

        event {
            id: "event1"
            extended_data_message_name: "sdv.test.diagnostics.FirstEventExt"
            fault_listener_mask: 0x3
        }

        routine {
            id: "routine1"
            start {
                request: "sdv.test.diagnostics.RoutineRequestParameter"
                response: "sdv.test.diagnostics.RoutineResponseParameter"
            }
            stop {
                response: "Temperature"
            }
            result {
                response: "Temperature"
            }
        }
    }

    build_cfg {
        target_name: "all_service_bundle_feature_tested"
        skip_codegen: false
    }

    register_reflection_metadata: true
}