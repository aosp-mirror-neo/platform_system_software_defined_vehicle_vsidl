# proto-file: //system/software_defined_vehicle/core_services/vsidl/protos/sdv/vsidl/v1/syntax.proto
# proto-message: VsidlEntry

package: "sdv.golden"

service_bundle {
    name: "GoldenSingleFileGroupClientSubscriber"

    client {
        service: "sdv.golden.rpc.TireStatus"
    }
    subscriber {
        message: "VehicleSpeedA"
    }
    subscriber {
        message: "sdv.golden.VehicleSpeedB"
    }
}

service_bundle {
    name: "GoldenSingleFileGroupServerPublisher"
    publisher {
        message: "VehicleSpeedA"
    }
    publisher {
        message: "VehicleSpeedB"
    }
    server {
        service: "sdv.golden.rpc.TireStatus"
    }
}
