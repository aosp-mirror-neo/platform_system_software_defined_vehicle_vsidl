package {
    default_applicable_licenses: ["sdv_license"],
}

// Golden sample to cover scenario
rust_protobuf {
    name: "libsdv_vsidlc_goldens_with_subfolder_folder_b_catalog",
    crate_name: "sdv_vsidlc_goldens_with_subfolder_folder_b_catalog",
    protos: [
        "*.proto",
    ],
    source_stem: "sdv_vsidlc_goldens_with_subfolder_folder_b_catalog_source",
    rustlibs: [
        "libvsidl_v1_stdlib_proto_rs",
    ],
    proto_flags: [
        "-I external/protobuf/src",
    ],
    host_supported: true,
    vendor_available: true,
    product_available: true,
}
