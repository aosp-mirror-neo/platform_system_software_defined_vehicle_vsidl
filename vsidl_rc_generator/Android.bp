package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_automotive",
}

rust_defaults {
    name: "vsidl_rc_defaults",
    defaults: ["sdv@rust_defaults"],
    srcs: [
        "src/templates/android_bp.tpl",
    ],
    rustlibs: [
        "libtinytemplate",
        "libvsidlc_cli",
        "libvsidl_v1_parser",
        "libvsidl_v1_proto_rs",
        "libsdv_vsidl_common",
        "libprotobuf",
        "libanyhow",
        "libclap",
        "libheck",
        "libchrono",
    ],
    proc_macros: ["libserde_derive"],
}

rust_library_host {
    name: "libvsidl_rc_generator",
    crate_name: "vsidl_rc_generator",
    defaults: [
        "vsidl_rc_defaults",
    ],
    crate_root: "src/lib.rs",
    // compile_multilib: first is required because we are depending on vsidlc targets
    compile_multilib: "first",
}

rust_binary_host {
    name: "vsidl_rc_generator",
    crate_name: "vsidl_rc_generator",
    crate_root: "src/main.rs",
    defaults: [
        "vsidl_rc_defaults",
    ],
    rustlibs: [
        "libvsidl_rc_generator",
    ],
}

genrule {
    name: "diagnostics_v1_in_subfolder",
    srcs: [":diagnostics_v1_catalog_files"],
    out: [
        // You must explicitly list the expected output files here with their new paths.
        // Wildcards are NOT allowed in 'out'.
        "diagnostics_v1_catalog_files/authentication_service.proto",
        "diagnostics_v1_catalog_files/connection.proto",
        "diagnostics_v1_catalog_files/data_item_service.proto",
        "diagnostics_v1_catalog_files/diagnostics_manager_service.proto",
        "diagnostics_v1_catalog_files/ecu_reset_service.proto",
        "diagnostics_v1_catalog_files/event.proto",
        "diagnostics_v1_catalog_files/fault_listener_service.proto",
        "diagnostics_v1_catalog_files/file_transfer_service.proto",
        "diagnostics_v1_catalog_files/io_control_service.proto",
        "diagnostics_v1_catalog_files/response_code.proto",
        "diagnostics_v1_catalog_files/routine_control_service.proto",
        "diagnostics_v1_catalog_files/security_access_service.proto",
        "diagnostics_v1_catalog_files/Android.bp",
    ],
    // Creates the directory and copies all inputs into it
    cmd: "mkdir -p $(genDir)/diagnostics_v1_catalog_files && cp $(in) $(genDir)/diagnostics_v1_catalog_files/",
}

rust_test_host {
    name: "sdv_core_vsidl_unit_vsidl_rc_generator_test",
    defaults: ["vsidl_rc_defaults"],
    crate_root: "src/lib.rs",
    test_options: {
        unit_test: true,
    },
    data: [
        "src/tests/**/*",
        ":sdv_vsidl_v1_protos",
        ":diagnostics_v1_in_subfolder",
    ],
    rustlibs: [
        "libgoogletest_rust",
        "libtempfile",
        "libvsidl_rc_generator",
    ],
    test_suites: [
        "general-tests",
        "automotive-sdv-tests",
        "sdv-host-unit-tests",
    ],
}

rust_test_host {
    name: "sdv_core_vsidl_unit_vsidl_rc_generator_golden_tests",
    defaults: ["vsidl_rc_defaults"],
    rustlibs: [
        "libvsidl_rc_generator",
        "libtempfile",
    ],
    test_options: {
        unit_test: true,
    },
    test_suites: [
        "automotive-sdv-tests",
        "sdv-host-unit-tests",
    ],
    data: [
        "src/tests/**/*",
        ":sdv_vsidl_v1_protos",
        ":diagnostics_v1_in_subfolder",
    ],
    crate_root: "src/tests/latest/golden_tests.rs",
}
