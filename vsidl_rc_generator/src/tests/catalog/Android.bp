package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_protobuf {
    name: "libstable_test_tire_proto",
    crate_name: "stable_test_tire_proto",
    protos: [
        "**/*.proto",
    ],
    source_stem: "stable_test_tire_proto_source",
    rustlibs: [
        "libvsidl_v1_proto_rs",
        "libdiagnostics_v1_api",
    ],
    proto_flags: [
        "-I external/protobuf/src",
    ],
    vendor_available: true,
    product_available: true,
}

filegroup {
    name: "stable_test_tire_catalog_protos",
    srcs: [
        "**/*.proto",
        "**/*.vsidl",
        "Android.bp",
    ],
}
