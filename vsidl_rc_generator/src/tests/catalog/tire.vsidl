# proto-message: VsidlEntry

package: "sdv.transmission"

service_bundle {
    name: "Manager"

    publisher {
        message: "TirePressure"
        channel: "FRONT_LEFT"
        channel: "FRONT_RIGHT"
    }
}

service_bundle {
    name: "Monitor"

    subscriber {
        message: "TirePressure"
        channel: "FRONT_LEFT"
        channel: "FRONT_RIGHT"
    }

    publisher {
        message: "TirePressureRange"
    }
}
