package: "sdv.transmission2"

service_bundle {
    name: "OtherManager"

    publisher {
        message: "OtherTirePressure"
        channel: "FRONT_LEFT"
        channel: "FRONT_RIGHT"
    }
}

service_bundle {
    name: "OtherMonitor"

    subscriber {
        message: "OtherTirePressure"
        channel: "FRONT_LEFT"
        channel: "FRONT_RIGHT"
    }

    publisher {
        message: "OtherTirePressureRange"
    }
}
