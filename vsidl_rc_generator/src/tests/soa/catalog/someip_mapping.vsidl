# proto-file: //system/software_defined_vehicle/vsidl/language/src/protos/sdv/someip/v1/someip.proto
# proto-message: SomeIpMapping

package: "sdv.tests.soa.transmission"

some_ip_mapping {
  someip_service_mapping {
    someip_service_id: 0x4200
    version_major: 0x1
    version_minor: 0x0
    instance {
        instance_id: 0x1000
    }
    instance_impl {
        offered_event {
          group_id: 0x9000
          event_id: 0x8001
          simple_event {
            sdv_unit_type {
              package_name: "sdv.tests.soa.transmission"
              type_name: "TirePressure"
            }
            topic: "front-left"
            capacity: 10
            type_definition {
                length_field_size: ZERO
                field {
                  field_name: "pressure"
                  field_type { someip_primitive: UINT32 }
                }
            }
          }
        }
        offered_event {
          group_id: 0x9000
          event_id: 0x8002
          simple_event {
            sdv_unit_type {
              package_name: "sdv.tests.soa.transmission"
              type_name: "TireTemperature"
            }
            topic: "front-right"
            capacity: 8
            type_definition {
                length_field_size: ZERO
                field {
                  field_name: "temperature"
                  field_type { someip_primitive: UINT32 }
                }
            }
          }
        }
      }
  }
}
