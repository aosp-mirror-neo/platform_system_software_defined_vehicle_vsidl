# proto-file: //system/software_defined_vehicle/vsidl/language/src/protos/sdv/someip/v1/someip.proto
# proto-message: SomeIpMapping

package: "com.android.sdv.sample.someip"

some_ip_mapping {
  sdv_type_mapping {
    unit_type {
      package_name: "com.android.sdv.sample.someip"
      type_name: "CounterLoadSoa"
    }
    someip_service_id: 0x14
    version_major: 0x1
    version_minor: 0x0
    service_oriented_mapping {
      publication_mapping {
        offered_topic {
          type_definition {
            length_field_size: ZERO
            field {
              field_name: "pressure"
              field_type { someip_primitive: UINT32 }
            }
          }
          someip_ff_methods: true
        }
        topic_mapping {
          topic: "soa-topic"
          instance_id: 0x1
          fire_and_forget_method {
            service_id: 0x3701
            instance_id: 0x1000
            version_major: 0x1
            version_minor: 0x0
            method_id: 0x1000
          }
        }
      }
    }
  }
}

