package \{
    default_applicable_licenses: ["Android-Apache-2.0"],
}

{{- for package in packages }}

// Pre-compiled file with VSIDL schemas for {package}.
//
// Usage: add the following line to {package} manifest declaration
// for each service bundle that is using this shared file:
// + vsidl_schemas_path: "etc/vsidl_provider/vsidl-config.binpb"
prebuilt_etc \{
    name: "{package}-vsidl-config.binpb",
    filename: "vsidl-config.binpb",
    sub_dir: "vsidl_provider",
    src: ":generate_vsidl_files_single_apex_{package}\{vsidl-config.binpb}",
    installable: false,
}

genrule \{
    name: "generate_vsidl_files_single_apex_{package}",
    tools: ["vsidl_rc_generator"],
    srcs: [
        ":sdv_v1_catalog_files",
        ":sdv_vsidl_v1_protos",
        ":{filegroup}",
    ],
    cmd: "$(location vsidl_rc_generator) " +
        " --vsidl-path  system/software_defined_vehicle/vsidl/language/src/protos" +
        " --catalog-path {catalog_path}" +
        " --output-path $(genDir) " +
{{- for dependency in dependencies }}
        " --dependency-catalog-path {dependency}" +
{{- endfor }}
        " --package-name {package}",
    out: [
        "vsidl-config.binpb",
    ],
}
{{- endfor }}

